# Copy to .env for local runs. Real .env files never enter the repo.
FINANCE_DATABASE_URL=postgres://admin:root@localhost:5432/finance?sslmode=disable
FINANCE_JWKS_URL=http://localhost:8081/.well-known/jwks.json
FINANCE_HTTP_PORT=8083
FINANCE_GRPC_PORT=9093
FINANCE_NATS_URL=nats://localhost:4222
FINANCE_BASE_CURRENCY=UAH
FINANCE_TIMEZONE=Europe/Kyiv
FINANCE_LOG_LEVEL=debug
FINANCE_LOG_JSON=false
