# Copy to .env for local runs. Real .env files never enter the repo.
AUTH_DATABASE_URL=postgres://admin:root@localhost:5432/auth?sslmode=disable

# ES256 signing key. Generate one with:
#   openssl ecparam -name prime256v1 -genkey -noout -out auth-signing-key.pem
# Then either point at the file:
AUTH_SIGNING_KEY_FILE=./auth-signing-key.pem
# ...or inline it with escaped newlines (AUTH_SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----\n...").
# There is no default: a missing key must stop the service, not be invented.

AUTH_HTTP_PORT=8081
AUTH_GRPC_PORT=9091

# services/family's internal listener, used to stamp the family_id claim when minting a token.
# Leave empty to mint tokens without it (apps then show onboarding).
AUTH_FAMILY_ADDR=http://localhost:9092

AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_LOG_LEVEL=debug
AUTH_LOG_JSON=false
