# Copy to .env for local runs. Real .env files never enter the repo.
AUTH_DATABASE_URL=postgres://admin:root@localhost:5432/auth?sslmode=disable

# ES256 signing key. Generate one with:
#   openssl ecparam -name prime256v1 -genkey -noout -out auth-signing-key.pem
# Then either point at the file:
AUTH_SIGNING_KEY_FILE=./auth-signing-key.pem
# ...or inline it with escaped newlines (AUTH_SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----\n...").
# There is no default: a missing key must stop the service, not be invented.

AUTH_HTTP_PORT=8081
AUTH_GRPC_PORT=9091

# services/family's internal listener, used to stamp the family_id claim when minting a token.
# Leave empty to mint tokens without it (apps then show onboarding).
AUTH_FAMILY_ADDR=http://localhost:9092

# How many argon2id hashes may run at once. Each holds ~19 MiB while it runs, and Register
# and Login are both unauthenticated, so this is what decides whether a burst of sign-ins
# queues or takes the box out of memory. Empty means GOMAXPROCS.
AUTH_HASH_CONCURRENCY=

# Failed sign-ins for one address: how many are allowed before the next attempt is refused,
# and the lockout that follows (doubling from base, capped at max). Empty means 10, 10s, 5m.
# Per account rather than per IP — the address is what is under attack, and a household behind
# one NAT would otherwise share a limit with each other.
AUTH_LOGIN_FAILURE_THRESHOLD=
AUTH_LOGIN_LOCKOUT_BASE=
AUTH_LOGIN_LOCKOUT_MAX=

AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_LOG_LEVEL=debug
AUTH_LOG_JSON=false
