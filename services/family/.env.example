# Copy to .env for local runs. Real .env files never enter the repo.
FAMILY_DATABASE_URL=postgres://admin:root@localhost:5432/family?sslmode=disable
FAMILY_JWKS_URL=http://localhost:8081/.well-known/jwks.json
FAMILY_HTTP_PORT=8082
FAMILY_GRPC_PORT=9092
FAMILY_NATS_URL=nats://localhost:4222
FAMILY_LOG_LEVEL=debug
FAMILY_LOG_JSON=false
FAMILY_INVITATION_TTL=168h
