# Copy to .env for local runs. Real .env files never enter the repo.
NOTES_DATABASE_URL=postgres://admin:root@localhost:5432/notes?sslmode=disable
NOTES_JWKS_URL=http://localhost:8081/.well-known/jwks.json
NOTES_HTTP_PORT=8085
NOTES_GRPC_PORT=9095
NOTES_NATS_URL=nats://localhost:4222
NOTES_LOG_LEVEL=debug
NOTES_LOG_JSON=false
# No NOTES_STORAGE_* here on purpose. v1 ships no image blocks, and the service is meant to
# run with object storage unconfigured: config.Load defaults let it boot, imagesOrNil logs
# "image storage disabled", UploadNoteImage errors, and nothing calls EnsureBucket — which is
# the point. libs/go/storage sets an anonymous-read policy on every bucket it creates, so a
# photo in a never-shared note would be readable by anyone with the URL, and unsharing the note
# would not take the image back. Setting NOTES_STORAGE_ENDPOINT locally re-creates that bucket
# on your MinIO; do it only when you are working on presigned reads in libs/go/storage.
