{
  "name": "@fm/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design-system components shared by every app. Styling is NativeWind classes over @fm/theme tokens; no app-local colour literals.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "echo \"presentational components are covered by the apps that render them\""
  },
  "dependencies": {
    "@fm/config": "workspace:*",
    "@fm/theme": "workspace:*"
  },
  "peerDependencies": {
    "nativewind": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "nativewind": "^4.2.6",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4",
    "typescript": "^5.7.0"
  }
}
