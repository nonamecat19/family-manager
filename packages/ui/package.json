{
  "name": "@fm/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design-system components shared by every app. Styling is NativeWind classes over @fm/theme tokens; no app-local colour literals.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "echo \"presentational components are covered by the apps that render them\""
  },
  "dependencies": {
    "@fm/config": "workspace:*",
    "@fm/theme": "workspace:*"
  },
  "peerDependencies": {
    "nativewind": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-svg": "15.8.0",
    "typescript": "^5.7.0"
  }
}
