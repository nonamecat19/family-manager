{
  "expo": {
    "name": "Family Finance",
    "slug": "fm-finance",
    "scheme": "fmfinance",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "//": "Overridden per environment; the app reads this through expo-constants.",
      "apiBaseUrl": "http://localhost:8083"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.familymanager.finance"
    },
    "android": {
      "package": "dev.familymanager.finance",
      "adaptiveIcon": {
        "backgroundColor": "#2F855A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
