{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commonplace",
  "version": "0.1.0",
  "identifier": "dev.familymanager.notes",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Commonplace",
        "width": 1240,
        "height": 790,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#161826"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Family notes",
    "longDescription": "Commonplace — notebooks, notes made of blocks, and sharing inside one family.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
